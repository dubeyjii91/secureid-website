{
  "expo": {
    "name": "SecureID",
    "slug": "secureid-mobile",
    "scheme": "secureid",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.secureid.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "SecureID can use Face ID to unlock the app after account security is configured."
      }
    },
    "android": {
      "package": "com.secureid.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#071323",
        "foregroundImage": "./assets/secureid-icon.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SecureID to use Face ID to unlock the app."
        }
      ],
      "expo-document-picker",
      "expo-font",
      "expo-notifications",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "95abc66d-901c-4a15-aa86-b11200934001"
      }
    },
    "icon": "./assets/secureid-icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/95abc66d-901c-4a15-aa86-b11200934001"
    }
  }
}
