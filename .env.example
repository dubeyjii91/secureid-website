# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=5000
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=./data/secureid.sqlite
BCRYPT_ROUNDS=10
# Local-only mode keeps the API runnable but refuses to generate undeliverable OTPs.
# Choose smtp, resend, or brevo and configure that provider below for working MFA.
OTP_DELIVERY=console
OTP_RESEND_COOLDOWN_SECONDS=60

# Set stable random values locally so sessions and outstanding OTP challenges
# remain verifiable after an API restart. Generate each independently.
# Production values belong in your deployment secret manager.
SESSION_HASH_SECRET=
OTP_HASH_SECRET=

# Production email delivery: choose OTP_DELIVERY=smtp, OTP_DELIVERY=resend,
# or OTP_DELIVERY=brevo. An explicit selection takes precedence over saved keys.
# Resend requires a verified sender domain for production accounts.
# The resend.dev test sender is not for OTP delivery to real SecureID users.
RESEND_API_KEY=
OTP_FROM_EMAIL=

# SMTP alternative (e.g. Brevo SMTP relay). Keep credentials in your secret manager.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SECURITY_ALERT_EMAIL=

# Required in production: stable 32-byte base64 key for AES-256-GCM document encryption.
# Keep this key backed up separately; losing it makes stored documents unreadable.
DOCUMENT_ENCRYPTION_KEY=

# Required for encrypted database/document backups (scripts/secure-backup.mjs).
# Keep separate from DOCUMENT_ENCRYPTION_KEY and store in the hosting secret manager.
BACKUP_ENCRYPTION_KEY=

# Set to the exact number of trusted reverse-proxy hops. Leave 0 when direct.
TRUST_PROXY_HOPS=0
